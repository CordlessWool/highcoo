# E2E tests — separate DB so tests don't touch dev data
# Create once: podman exec highcoo-db-1 psql -U highcoo -c "CREATE DATABASE highcoo_test;"
DATABASE_URL_TEST=postgresql://highcoo:highcoo@localhost:5432/highcoo_test

